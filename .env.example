# 必需配置
DEEPSEEK_API_KEY=sk-your-api-key-here

# 可选配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 必需：提供 OpenAI-compatible /v1/embeddings 的独立服务
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_BASE_URL=https://your-embedding-provider.example.com
EMBEDDING_MODEL=text-embedding-3-small
# 目标向量维度（Matryoshka 截断）。改这个值之后必须：
#   1) python scripts/rebuild_embeddings.py     重建全库
#   2) python scripts/calibrate_thresholds.py   重标 SIMILARITY_MID / SIMILARITY_HIGH
EMBEDDING_DIM=512

MEMORY_DB_PATH=data/memories.db

# ── 埋点日志（论文实验用，生产默认关闭）──────────────────
# 打开后每条记忆每次会话写一行，行数会远超 memories 表本身。
# DECAY_LOG_ENABLED=false
# ACCESS_LOG_ENABLED=false
# EVENT_LOG_RETENTION_DAYS=30

# ── 记忆增长治理 ─────────────────────────────────────────
# 冷归档：沉底 + 从未被用过 + 超过 N 天无访问的 episodic 移入归档表（不是删除）
# ARCHIVE_ENABLED=true
# ARCHIVE_IDLE_DAYS=90
# SUPERSEDED_RETENTION_DAYS=30
# ARCHIVE_RUN_EVERY_SESSIONS=20
# 自动合并会在退出时静默发起 LLM 调用，需显式开启
# CONSOLIDATE_AUTO_ENABLED=false
# CONSOLIDATE_AUTO_THRESHOLD=300

# ── 检索后端 ─────────────────────────────────────────────
# FTS_ENABLED=true                # FTS5 关键词倒排索引（trigram，对中文有效）
# ANN_BACKEND_THRESHOLD=20000     # 活跃记忆超此数时提示改用 sqlite-vec

# MCP Streamable HTTP（默认仅本机访问）
ENGRAMTIDE_MCP_HOST=127.0.0.1
ENGRAMTIDE_MCP_PORT=8765
ENGRAMTIDE_MCP_PATH=/mcp
# 仅监听非本机地址时必填，例如 192.168.1.10:8765
# ENGRAMTIDE_MCP_ALLOWED_HOSTS=192.168.1.10:8765
# 浏览器型 MCP 客户端按需填写完整 Origin，多个值用逗号分隔
# ENGRAMTIDE_MCP_ALLOWED_ORIGINS=http://192.168.1.20:3000
ENGRAMTIDE_SESSION_TTL_SECONDS=86400
ENGRAMTIDE_MAX_SESSIONS=32
