# 必需配置
DEEPSEEK_API_KEY=sk-your-api-key-here

# 可选配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 必需：提供 OpenAI-compatible /v1/embeddings 的独立服务
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_BASE_URL=https://your-embedding-provider.example.com
EMBEDDING_MODEL=text-embedding-3-small

MEMORY_DB_PATH=data/memories.db

# MCP Streamable HTTP（默认仅本机访问）
ENGRAMTIDE_MCP_HOST=127.0.0.1
ENGRAMTIDE_MCP_PORT=8765
ENGRAMTIDE_MCP_PATH=/mcp
# 仅监听非本机地址时必填，例如 192.168.1.10:8765
# ENGRAMTIDE_MCP_ALLOWED_HOSTS=192.168.1.10:8765
# 浏览器型 MCP 客户端按需填写完整 Origin，多个值用逗号分隔
# ENGRAMTIDE_MCP_ALLOWED_ORIGINS=http://192.168.1.20:3000
ENGRAMTIDE_SESSION_TTL_SECONDS=86400
ENGRAMTIDE_MAX_SESSIONS=32
